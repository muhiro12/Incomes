{
  "organization": "Hiromu Nakano",
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "es",
      "fr",
      "ja",
      "zh-Hans",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "IncomesLibrary",
    }, {
      "kind": "remote",
      "repository": "https://github.com/muhiro12/MHPlatform",
      "version": {
        "up-to-next-major-version": "1.14.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/SimplyDanny/SwiftLintPlugins",
      "version": {
        "up-to-next-major-version": "0.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/muhiro12/MHUI",
      "version": {
        "up-to-next-major-version": "2.3.0",
      },
    },
  ],
  "files": [
    { "path": "IncomesLibrary" },
    {
      "kind": "folder",
      "path": "Incomes",
      "target-membership": [
        "Incomes",
      ],
      "membership-exceptions": [
        {
          "target": "Incomes",
          "exclusions": [
            "Configurations/Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "Widgets",
      "target-membership": [
        "Widgets",
      ],
      "membership-exceptions": [
        {
          "target": "Widgets",
          "exclusions": [
            "Configurations/Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "Watch", "target-membership": [ "Watch" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Incomes.app", "id": "ADCF36A624A1D0F40011D6F5", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Widgets.appex", "id": "AD71621A2E70BC5C00C4CFCE", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Incomes/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/Watch.app", "id": "AD6DB6D22E779B2B00E5BB78", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "Incomes/copy/Embed Watch Content", "header-preservation": "remove-on-copy" } ] },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/CloudKit.framework" },
        { "path": "<SDK>/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "Widgets/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "Widgets/frameworks" ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Incomes",
      "id": "ADCF36A524A1D0F40011D6F5",
      "product": "Products/Incomes.app",
      "product-type": "application",
      "last-swift-migration": "11.5",
      "dependencies": [
        "Widgets",
        "Watch",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        },
      ],
      "package-product-members": [
        {
          "product-name": "IncomesLibrary",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "MHPlatform",
          "product-name": "MHPlatform",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "MHUI",
          "product-name": "MHDesign",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CLANG_ANALYZER_LOCALIZABILITY_NONLOCALIZED": "NO",
        "CLANG_ENABLE_MODULES": "YES",
        "CODE_SIGN_ENTITLEMENTS": "Incomes/Configurations/Incomes.entitlements",
        "CODE_SIGN_IDENTITY[config=Debug]": "Apple Development",
        "CODE_SIGN_IDENTITY[config=Release][sdk=macosx*]": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_ASSET_PATHS": "",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "YES",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Incomes/Configurations/Info.plist",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.finance",
        "INFOPLIST_KEY_NSCameraUsageDescription": "Camera access is required to scan receipts.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIStatusBarStyle": "",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRIght UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortrait",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown",
        "INFOPLIST_OUTPUT_FORMAT": "same-as-input",
        "IPHONEOS_DEPLOYMENT_TARGET": "18.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "14.6",
        "MARKETING_VERSION": "6.0",
        "OTHER_LDFLAGS": "-ObjC",
        "PLIST_FILE_OUTPUT_FORMAT": "same-as-input",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.muhiro12.Incomes",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "SDKROOT": "iphoneos",
        "STRINGS_FILE_OUTPUT_ENCODING": "UTF-16",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "VALIDATE_PRODUCT": "NO",
      },
    }, {
      "name": "Widgets",
      "id": "AD7162192E70BC5C00C4CFCE",
      "product": "Products/Widgets.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "IncomesLibrary",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "MHUI",
          "product-name": "MHDesign",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "ASSETCATALOG_COMPILER_WIDGET_BACKGROUND_COLOR_NAME": "WidgetBackground",
        "CLANG_CXX_LANGUAGE_STANDARD": "gnu++20",
        "CODE_SIGN_ENTITLEMENTS": "Widgets/Configurations/Widgets.entitlements",
        "CODE_SIGN_IDENTITY[config=Debug]": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "GCC_C_LANGUAGE_STANDARD": "gnu17",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Widgets/Configurations/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Incomes",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "Copyright © 2025 Hiromu Nakano. All rights reserved.",
        "IPHONEOS_DEPLOYMENT_TARGET": "18.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "MARKETING_VERSION": "6.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.muhiro12.Incomes.Widgets",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SKIP_INSTALL": "YES",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "Watch",
      "id": "AD6DB6D12E779B2B00E5BB78",
      "product": "Products/Watch.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "IncomesLibrary",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "MHPlatform",
          "product-name": "MHPreferences",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "MHPlatform",
          "product-name": "MHPreferencesUI",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "MHUI",
          "product-name": "MHDesign",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
