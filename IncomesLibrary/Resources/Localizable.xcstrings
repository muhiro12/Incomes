    "A newer version of Incomes created this file. Update Incomes and try again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A newer version of Incomes created this file. Update Incomes and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo se creó con una versión más reciente de Incomes. Actualiza Incomes e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier a été créé par une version plus récente d’Incomes. Mettez à jour Incomes et réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルは新しいバージョンのIncomesで作成されました。Incomesをアップデートしてから、もう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件由较新版本的 Incomes 创建。请更新 Incomes 后重试。"
          }
        }
      }
    },
    "Compared with the previous month, %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compared with the previous month, %1$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En comparación con el mes anterior, %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par rapport au mois précédent, %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前月と比べると、%1$@。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与上月相比，%1$@。"
          }
        }
      }
    },
    "Income for %@ was %@. Outgo was %@, and the net income was %@. %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Income for %1$@ was %2$@. Outgo was %3$@, and the net income was %4$@. %5$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ingresos de %1$@ fueron %2$@. Los gastos fueron %3$@, y el ingreso neto fue %4$@. %5$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les revenus de %1$@ étaient de %2$@. Les dépenses étaient de %3$@, pour un revenu net de %4$@. %5$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@の収入は%2$@でした。支出は%3$@で、純収入は%4$@でした。%5$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@的收入为%2$@。支出为%3$@，净收入为%4$@。%5$@"
          }
        }
      }
    },
