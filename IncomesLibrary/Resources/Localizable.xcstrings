    "The balance cannot be calculated exactly. Review the income and outgo amounts and try again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The balance cannot be calculated exactly. Review the income and outgo amounts and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede calcular el saldo con exactitud. Revisa los importes de ingresos y gastos e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le solde ne peut pas être calculé exactement. Vérifiez les montants des revenus et des dépenses, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残高を正確に計算できません。収入と支出の金額を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法精确计算余额。请检查收入和支出金额，然后重试。"
          }
        }
      }
    },
    "The last balance preview no longer matches this entry. Preview it again." : {
