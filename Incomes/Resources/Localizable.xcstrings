    "Add income items with categories to see this chart." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add income items with categories to see this chart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade elementos de ingreso con categorías para ver este gráfico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des éléments de revenu avec des catégories pour afficher ce graphique."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カテゴリ付きの収入項目を追加すると、このグラフを表示できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加带分类的收入项目后即可查看此图表。"
          }
        }
      }
    },
    "Add one item to start tracking income, outgo, and balance." : {
      "localizations" : {
