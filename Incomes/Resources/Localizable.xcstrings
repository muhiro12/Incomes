    "iCloud sync is on. This import also changes your other devices. If changes from another device have not arrived yet, items may be duplicated or reappear." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud sync is on. This import also changes your other devices. If changes from another device have not arrived yet, items may be duplicated or reappear."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización con iCloud está activada. Esta importación también cambia tus otros dispositivos. Si aún no han llegado los cambios de otro dispositivo, algunos elementos podrían duplicarse o volver a aparecer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation iCloud est activée. Cette importation modifie aussi vos autres appareils. Si des modifications d’un autre appareil ne sont pas encore arrivées, des éléments peuvent être dupliqués ou réapparaître."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud同期がオンです。この取り込みはほかのデバイスにも反映されます。ほかのデバイスからの変更がまだ届いていない場合、項目が重複したり、削除した項目が戻ったりすることがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步已开启。此次导入也会更改你的其他设备。如果其他设备的更改尚未同步过来，项目可能会重复或重新出现。"
          }
        }
      }
    },
