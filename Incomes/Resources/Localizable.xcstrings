    "Supported conditions: one month, words in the item name, and income or outgo ranges. Items must match every condition." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supported conditions: one month, words in the item name, and income or outgo ranges. Items must match every condition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condiciones disponibles: un mes, palabras del nombre y rangos de ingresos o gastos. Los registros deben cumplir todas las condiciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Critères pris en charge : un mois, du texte dans le nom et des plages de revenus ou de dépenses. Tous les critères doivent être remplis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ひと月、項目名に含む文字、収入・支出の金額範囲を指定できます。すべての条件に一致する収支を検索します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持的条件：一个月份、项目名称中的文字及收入或支出范围。收支须符合所有条件。"
          }
        }
      }
    },
