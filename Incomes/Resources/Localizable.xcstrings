    "The file can restore all items in Incomes. Keep it private; it includes your financial records." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file can restore all items in Incomes. Keep it private; it includes your financial records."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo permite restaurar todos los elementos en Incomes. Guárdalo en privado: contiene tus registros financieros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier permet de restaurer tous les éléments dans Incomes. Gardez-le privé : il contient vos données financières."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルでIncomesのすべての項目を復元できます。家計の記録が含まれるため、他人に見られないよう管理してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件可在 Incomes 中恢复所有项目。文件包含你的财务记录，请妥善保管。"
          }
        }
      }
    },
    "The file could not be imported. Your data has not changed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file could not be imported. Your data has not changed."
          }
