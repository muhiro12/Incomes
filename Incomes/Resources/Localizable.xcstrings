    "Adds items from the file and keeps your items. You decide how to handle items that differ on the same day." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds items from the file and keeps your items. You decide how to handle items that differ on the same day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade los elementos del archivo y conserva los tuyos. Tú decides qué hacer con los elementos que difieren el mismo día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute les éléments du fichier et conserve les vôtres. Vous choisissez comment traiter les éléments qui diffèrent le même jour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルの項目を追加し、今の項目は残します。同じ日に内容が異なる項目は、扱いを選べます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加文件中的项目并保留你现有的项目。对于同一天内容不同的项目，由你决定如何处理。"
          }
        }
      }
    },
