    "An on-device language model turns your request into search conditions. It can misread requests, so check the conditions. Saved items are only read, never changed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An on-device language model turns your request into search conditions. It can misread requests, so check the conditions. Saved items are only read, never changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un modelo de lenguaje del dispositivo convierte tu solicitud en condiciones de búsqueda. Revísalas, ya que puede interpretarla mal. Los registros guardados solo se leen; nunca se modifican."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un modèle de langue sur l’appareil transforme votre demande en critères de recherche. Vérifiez-les, car il peut se tromper. Les éléments enregistrés sont uniquement lus, jamais modifiés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末内の言語モデルが文章を検索条件に変換します。読み違える場合があるため、条件を確認してください。保存済みの収支は読み取るだけで、変更しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备上的语言模型将请求转换为搜索条件。模型可能误解请求，请核对条件。已保存的收支仅供读取，不会被更改。"
          }
        }
      }
    },
    "Applies suggestions to the item form." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
